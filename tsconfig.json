{
  "extends": "@vfourny/node-toolkit/tsconfig/base",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "paths": {
      "@/*": ["./src/*"],
      "@server/*": ["./server/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["src", "server", "shared", "prisma", "*.ts"],
  "exclude": ["node_modules", ".output", ".vercel", "dist"]
}
