{
  "extends": "@vfourny/node-toolkit/tsconfig/react",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@server/*": ["./server/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".output", ".vercel", ".pnpm-store", "Claude outputs"]
}
