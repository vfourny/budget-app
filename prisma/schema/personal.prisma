// ─── Budget perso (enveloppes, IR) ───────────────────────────────────────────────────────────────────

/// Enveloppes budgétaires (méthode des « comptes » / enveloppes).
enum Envelope {
  CURRENT_EXPENSES // Dépenses courantes
  LEISURE // Loisirs
  TRAINING // Formation
  SAFETY_SAVINGS // Épargne sécurité
  LONG_TERM_SAVINGS // Épargne long terme
}

/// Part du revenu mensuel recommandée pour une enveloppe (en %). Une ligne par (utilisateur, enveloppe)
/// configurée ; sans ligne, la valeur par défaut de `DEFAULT_ENVELOPE_PERCENTS` (`shared/personal/personal.rules.ts`) s'applique.
model EnvelopeShare {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope Envelope
  percent  Int

  @@id([userId, envelope])
}
