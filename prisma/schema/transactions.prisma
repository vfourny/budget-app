// ─── Relevés importés et transactions ────────────────────────────────────────────────────────────────

/// Nature d'un relevé / d'une transaction : compte personnel ou compte pro (Stygma).
enum AccountType {
  PERSONAL // Perso
  PROFESSIONAL // Pro (Stygma)
}

/// Catégorie d'une transaction (liste figée, colonnes du Google Sheet). Le libellé affiché et
/// l'enveloppe de rattachement vivent dans `src/lib/i18n/fr/enums.ts` et `shared/budget-rules.ts`.
enum TransactionCategory {
  RENT // Loyer
  FUEL // Essence
  BANK_INSURANCE // Banque et assurance
  RESTAURANT // Restaurant
  GROCERIES // Alimentaire
  NIGHTLIFE // Soirée
  LEISURE // Loisirs
  CLOTHING_CARE // Vêtements & Soins
  HEALTH // Santé
  TRANSPORT // Transport
  TAXES // Impôts et taxes
  OTHER_SUBSCRIPTIONS // Abonnements divers (streaming, logiciels…)
  ENERGY // Énergie (électricité, gaz)
  TELECOM // Télécom (forfait téléphone)
  INTERNET // Internet (box)
  OTHER // Autres
  LONG_TERM_SAVINGS // Épargne long terme
  SALARY_PAYMENT // Versement salaire (revenu)
  BNC_PAYMENT // Versement BNC (revenu)
  VACATION_PAYMENT // Versement vacation (revenu)
  REFUND // Autre remboursement (crédit)
  PROFESSIONAL_REFUND // Remboursement pro : frais mixtes perso/pro remboursés par Stygma (crédit)
  TRAINING // Formation
  SHORT_TERM_SAVINGS // Épargne court terme
  // ── Compte pro (Stygma) : catégories proposées seulement pour les relevés pro (voir
  // `PRO_CATEGORIES` dans `shared/account-categories.ts`).
  CLIENT_PAYMENT // Encaissement d'une facture client (crédit)
  PRO_OTHER_CREDIT // Autre crédit pro
  PRO_INSURANCE // RC Pro, assurances de la société
  PRO_ACCOUNTANT // Expert-comptable
  PRO_BANK_FEES // Frais et cotisations bancaires pro
  PRO_EQUIPMENT // Petit matériel
  PRO_SOFTWARE // Logiciels et abonnements pro
  PRO_MEALS // Restauration pro
  PRO_TRAVEL // Voyages et déplacements
  PRO_TAXES // Impôts et taxes de la société (CFE, pénalités…)
  PRO_OTHER // Autres charges pro
  NET_SALARY_TRANSFER // Salaire net viré au président
  BNC_WITHDRAWAL // Revenus BNC prélevés (virement vers le perso)
  MIXED_COSTS_REFUND // Remboursement des frais mixtes payés en perso
  URSSAF // Cotisations URSSAF
  SUPPLEMENTARY_PENSION // Retraite complémentaire
  HEALTH_COVER // Complémentaire santé
  DISABILITY_COVER // Prévoyance
  WITHHOLDING_TAX // Prélèvement à la source (DGFIP PAS)
  VAT_PAYMENT // Paiement de la TVA
}

enum ImportStatus {
  PENDING_REVIEW // En attente de relecture
  VALIDATED // Validé
}

/// Un fichier de relevé importé. Ses transactions sont écrites dès l'import (sans catégorie) ;
/// seuls les imports VALIDATED comptent dans les dashboards.
model ImportBatch {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountType  AccountType
  fileName     String
  status       ImportStatus  @default(PENDING_REVIEW)
  createdAt    DateTime      @default(now())
  validatedAt  DateTime?
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id                 String               @id @default(cuid())
  userId             String
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime             @db.Date
  label              String
  /// Montant en centimes, signé : négatif = débit, positif = crédit.
  amountCents        Int
  /// Dénormalisés depuis `date` pour les agrégations mois / année.
  month              Int                  @db.SmallInt
  year               Int                  @db.SmallInt
  accountType        AccountType
  category           TransactionCategory?
  /// Confiance (0 à 1) de la catégorie proposée par l'IA. `null` = catégorie absente ou choisie
  /// à la main. Sert à mettre en avant les lignes « À vérifier » à la relecture.
  categoryConfidence Float?
  importBatchId      String?
  importBatch        ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([userId, year, month])
  @@index([userId, accountType, year, month])
  @@index([category])
  @@index([importBatchId])
}
