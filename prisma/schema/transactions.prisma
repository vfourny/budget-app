// ─── Relevés importés et transactions ────────────────────────────────────────────────────────────────

/// Nature d'un relevé / d'une transaction : compte personnel ou compte pro (Stygma).
enum AccountType {
  PERSONAL // Perso
  PROFESSIONAL // Pro (Stygma)
  APARTMENT // Compte dédié aux appartements (chaque ligne est rattachée à un appartement)
}

/// Catégorie d'une transaction (liste figée, colonnes du Google Sheet). Le libellé affiché et
/// l'enveloppe de rattachement vivent dans `src/lib/i18n/fr/enums.ts` et `shared/personal-rules.ts`.
enum TransactionCategory {
  RENT_PAID // Loyer versé (loyer perçu : catégorie à part, avec le compte appartement)
  FUEL // Essence
  BANK_INSURANCE // Banque et assurance
  RESTAURANT // Restaurant
  GROCERIES // Alimentaire
  NIGHTLIFE // Soirée
  LEISURE // Loisirs
  CLOTHING_CARE // Vêtements & Soins
  HEALTH // Santé
  TRANSPORT // Transport
  TAXES // Impôts et taxes
  OTHER_SUBSCRIPTIONS // Abonnements divers (streaming, logiciels…)
  ENERGY // Énergie (électricité, gaz)
  TELECOM // Télécom (forfait téléphone)
  INTERNET // Internet (box)
  OTHER // Autres
  LONG_TERM_SAVINGS // Épargne long terme
  SALARY_PAYMENT // Versement salaire (revenu)
  BNC_PAYMENT // Versement BNC (revenu)
  VACATION_PAYMENT // Versement vacation (revenu)
  REFUND // Autre remboursement (crédit)
  PROFESSIONAL_REFUND // Remboursement pro : frais mixtes perso/pro remboursés par Stygma (crédit)
  TRAINING // Formation
  SHORT_TERM_SAVINGS // Épargne court terme
  // ── Compte pro (Stygma) : catégories proposées seulement pour les relevés pro (voir
  // `ACCOUNT_CATEGORIES.PROFESSIONAL` dans `shared/account-categories.ts`).
  CLIENT_PAYMENT // Encaissement d'une facture client (crédit)
  PROFESSIONAL_OTHER_CREDIT // Autre crédit pro
  PROFESSIONAL_INSURANCE // RC Pro, assurances de la société
  PROFESSIONAL_ACCOUNTANT // Expert-comptable
  PROFESSIONAL_BANK_FEES // Frais et cotisations bancaires pro
  PROFESSIONAL_EQUIPMENT // Petit matériel
  PROFESSIONAL_SOFTWARE // Logiciels et abonnements pro
  PROFESSIONAL_MEALS // Restauration pro
  PROFESSIONAL_TRAVEL // Voyages et déplacements
  PROFESSIONAL_TAXES // Impôts et taxes de la société (CFE, pénalités…)
  PROFESSIONAL_OTHER // Autres charges pro
  NET_SALARY_TRANSFER // Salaire net viré au président
  BNC_WITHDRAWAL // Revenus BNC prélevés (virement vers le perso)
  MIXED_COSTS_REFUND // Remboursement des frais mixtes payés en perso
  URSSAF // Cotisations URSSAF
  SUPPLEMENTARY_PENSION // Retraite complémentaire
  HEALTH_COVER // Complémentaire santé
  DISABILITY_COVER // Prévoyance
  WITHHOLDING_TAX // Prélèvement à la source (DGFIP PAS)
  VAT_PAYMENT // Paiement de la TVA
  // ── Compte appartement : catégories proposées seulement pour les relevés appartement
  // (`ENERGY` et `INTERNET` y sont réutilisées).
  APT_RENT_RECEIVED // Loyer net reçu (crédit, déjà net des frais de gérance)
  APT_LOAN_REPAYMENT // Échéance du prêt immobilier (capital + intérêts)
  APT_LOAN_INSURANCE // Assurance emprunteur
  APT_HOME_INSURANCE // Assurance habitation
  APT_CONDO_FEES // Charges de copropriété
  APT_PROPERTY_TAX // Taxe foncière
  APT_CFE // CFE
  APT_BANK_FEES // Frais bancaires du compte appartement
  APT_REGULARIZATION // Régularisation de charges (débit ou remboursement)
  APT_OWNER_CONTRIBUTION // Apport fonds perso (crédit : virement reçu du compte perso)
  APT_OTHER // Autres (non listé)
  // ── Compte perso : virement vers le compte appartement.
  APARTMENT_CONTRIBUTION // Apport appartement
}

enum ImportStatus {
  PENDING_REVIEW // En attente de relecture
  VALIDATED // Validé
}

/// Un fichier de relevé importé. Ses transactions sont écrites dès l'import (sans catégorie) ;
/// seuls les imports VALIDATED comptent dans les dashboards.
model ImportBatch {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountType  AccountType
  fileName     String
  status       ImportStatus  @default(PENDING_REVIEW)
  createdAt    DateTime      @default(now())
  validatedAt  DateTime?
  /// Appartement choisi à l'import (compte APARTMENT) : proposé par défaut à chaque ligne.
  apartmentId  String?
  apartment    Apartment?    @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([userId])
}

/// Format d'export CSV connu d'un utilisateur : l'empreinte de l'en-tête du fichier → comment lire
/// ses colonnes. Un fichier dont l'empreinte est connue est parsé sans passer par l'IA ; sinon le
/// format est détecté, confirmé par l'utilisateur puis enregistré ici.
model CsvFormat {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 de la 1re ligne du fichier (voir `csvFingerprint`).
  fingerprint String
  /// Nom indicatif (ex. « BoursoBank »), jamais utilisé pour choisir le parseur.
  name        String
  /// `CsvFormatConfig` (`shared/csv-format.ts`), revalidé par Zod à chaque lecture.
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, fingerprint])
}

model Transaction {
  id                 String               @id @default(cuid())
  userId             String
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime             @db.Date
  label              String
  /// Montant en centimes, signé : négatif = débit, positif = crédit.
  amountCents        Int
  /// Dénormalisés depuis `date` pour les agrégations mois / année.
  month              Int                  @db.SmallInt
  year               Int                  @db.SmallInt
  accountType        AccountType
  category           TransactionCategory?
  /// Confiance (0 à 1) de la catégorie proposée par l'IA. `null` = catégorie absente ou choisie
  /// à la main. Sert à mettre en avant les lignes « À vérifier » à la relecture.
  categoryConfidence Float?
  importBatchId      String?
  importBatch        ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  /// Appartement rattaché : obligatoire pour `accountType = APARTMENT` (vérifié par l'app).
  apartmentId        String?
  apartment          Apartment?           @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([userId, year, month])
  @@index([userId, accountType, year, month])
  @@index([category])
  @@index([importBatchId])
  @@index([userId, apartmentId, year, month])
}
