// ─── Appartements (suivi de trésorerie des biens en location) ───────────────────────────────────
// Règles métier : `docs/fonctionnel.md` › Appartements (R1 à R12). Montants en centimes (entiers), taux en
// points de base (3,00 % = 300). Les relevés du compte appartement sont des `ImportBatch` /
// `Transaction` de type `AccountType.APARTMENT`, rattachés à un `Apartment`.

/// Régime de location. Seul le LMNP existe pour l'instant : une nouvelle valeur viendra avec ses règles.
enum ApartmentKind {
  FURNISHED // Location meublée (LMNP)
}

model Apartment {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  kind                 ApartmentKind
  /// Bien confié à un gérant ; `false` = location en direct (ni facture de gérance, ni ligne de frais).
  managed              Boolean       @default(false)
  /// 1er jour du mois d'acquisition : l'appartement est actif à partir de ce mois (inclus).
  acquiredAt           DateTime      @db.Date
  priceCents           Int
  /// Frais de gérance en points de base du loyer (7,00 % = 700), pour le prévisionnel.
  managementFeeBps     Int           @default(0)
  /// Assurance emprunteur mensuelle, prélevée à part de l'échéance du prêt.
  creditInsuranceCents Int           @default(0)

  // Prêt à taux fixe : tous les champs sont renseignés ensemble, ou aucun (bien sans prêt).
  loanPrincipalCents Int?
  loanRateBps        Int?
  loanTermMonths     Int?
  loanFirstDueDate   DateTime? @db.Date

  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  yearOpenings       ApartmentYearOpening[]
  managementInvoices ManagementInvoice[]
  forecasts          ApartmentForecast[]
  importBatches      ImportBatch[]
  transactions       Transaction[]

  @@index([userId])
}

/// Solde réel du compte appartement au 1er janvier, saisi chaque année (0 à défaut).
model ApartmentYearOpening {
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartmentId         String
  apartment           Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  year                Int       @db.SmallInt
  /// Centimes, signé.
  openingBalanceCents Int

  @@id([apartmentId, year])
  @@index([userId])
}

/// Facture de gérance d'un mois, saisie à la main : le loyer arrive net, ses frais n'apparaissent
/// pas dans le relevé (R12). Ce ne sont pas des transactions.
model ManagementInvoice {
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartmentId    String
  apartment      Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  year           Int       @db.SmallInt
  month          Int       @db.SmallInt
  feesCents      Int
  extraFeesCents Int       @default(0)

  @@id([apartmentId, year, month])
  @@index([userId])
}

/// Ligne du tableau saisissable dans l'éditeur du prévisionnel (R3). Les valeurs reprennent les clés
/// des lignes du tableau (`shared/apartment-rules.ts`). Le crédit vient du tableau d'amortissement et
/// les frais de gérance du loyer × taux : ils ne se saisissent pas.
enum ApartmentForecastLine {
  grossRent
  electricity
  homeInsurance
  internetBox
  condoFees
  propertyTax
  cfe
  bankFees
  regularization
  other
}

/// Montant prévu d'une ligne pour un mois, saisi dans l'éditeur du prévisionnel (centimes, positif
/// pour une charge). Loyer brut, taxe foncière et CFE valent jusqu'à la saisie suivante ; les autres
/// lignes seulement pour leur mois (sans saisie : historique, voir R3).
model ApartmentForecast {
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartmentId String
  apartment   Apartment             @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  year        Int                   @db.SmallInt
  month       Int                   @db.SmallInt
  line        ApartmentForecastLine
  amountCents Int

  @@id([apartmentId, year, month, line])
  @@index([userId])
}
