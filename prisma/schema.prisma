// Prisma 7 : générateur "prisma-client" (client TS sans moteur Rust), sorti dans src/.
generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

// L'URL de connexion est dans prisma.config.ts (CLI) et src/server/db.ts (runtime).
datasource db {
  provider = "postgresql"
}

/// Nature d'un relevé / d'une transaction : compte personnel ou compte pro (Stygma).
enum AccountType {
  PERSONAL // Perso
  PROFESSIONAL // Pro (Stygma)
}

/// Enveloppes budgétaires (méthode des « comptes » / enveloppes).
enum Envelope {
  CURRENT_EXPENSES // Dépenses courantes
  LEISURE // Loisirs
  TRAINING // Formation
  SAFETY_SAVINGS // Épargne sécurité
  LONG_TERM_SAVINGS // Épargne long terme
}

/// Catégorie d'une transaction (liste figée, colonnes du Google Sheet). Le libellé affiché et
/// l'enveloppe de rattachement vivent dans `src/lib/i18n/fr/enums.ts` et `shared/budget-rules.ts`.
enum TransactionCategory {
  RENT // Loyer
  FUEL // Essence
  BANK_INSURANCE // Banque et assurance
  RESTAURANT // Restaurant
  GROCERIES // Alimentaire
  NIGHTLIFE // Soirée
  LEISURE // Loisirs
  CLOTHING_CARE // Vêtements & Soins
  HEALTH // Santé
  TRANSPORT // Transport
  TAXES // Impôts et taxes
  OTHER_SUBSCRIPTIONS // Abonnements divers (streaming, logiciels…)
  ENERGY // Énergie (électricité, gaz)
  TELECOM // Télécom (forfait téléphone)
  INTERNET // Internet (box)
  OTHER // Autres
  LONG_TERM_SAVINGS // Épargne long terme
  SALARY_PAYMENT // Versement salaire (revenu)
  BNC_PAYMENT // Versement BNC (revenu)
  VACATION_PAYMENT // Versement vacation (revenu)
  REFUND // Autre remboursement (crédit)
  PROFESSIONAL_REFUND // Remboursement pro : frais mixtes perso/pro remboursés par Stygma (crédit)
  TRAINING // Formation
  SHORT_TERM_SAVINGS // Épargne court terme
  // ── Compte pro (Stygma) : catégories proposées seulement pour les relevés pro (voir
  // `PRO_CATEGORIES` dans `shared/account-categories.ts`).
  CLIENT_PAYMENT // Encaissement d'une facture client (crédit)
  PRO_OTHER_CREDIT // Autre crédit pro
  PRO_INSURANCE // RC Pro, assurances de la société
  PRO_ACCOUNTANT // Expert-comptable
  PRO_BANK_FEES // Frais et cotisations bancaires pro
  PRO_EQUIPMENT // Petit matériel
  PRO_SOFTWARE // Logiciels et abonnements pro
  PRO_MEALS // Restauration pro
  PRO_TRAVEL // Voyages et déplacements
  PRO_TAXES // Impôts et taxes de la société (CFE, pénalités…)
  PRO_OTHER // Autres charges pro
  NET_SALARY_TRANSFER // Salaire net viré au président
  BNC_WITHDRAWAL // Revenus BNC prélevés (virement vers le perso)
  MIXED_COSTS_REFUND // Remboursement des frais mixtes payés en perso
  URSSAF // Cotisations URSSAF
  SUPPLEMENTARY_PENSION // Retraite complémentaire
  HEALTH_COVER // Complémentaire santé
  DISABILITY_COVER // Prévoyance
  WITHHOLDING_TAX // Prélèvement à la source (DGFIP PAS)
  VAT_PAYMENT // Paiement de la TVA
}

/// Part du revenu mensuel recommandée pour une enveloppe (en %). Une ligne par (utilisateur, enveloppe)
/// configurée ; sans ligne, la valeur par défaut de `DEFAULT_ENVELOPE_PERCENTS` (`shared/budget-rules.ts`) s'applique.
model EnvelopeShare {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope Envelope
  percent  Int

  @@id([userId, envelope])
}

/// Tranche du barème de l'IR (1 part) en vigueur une année donnée (`year` = année affichée dans le
/// dashboard). `fromCents` = seuil bas de la tranche, `ratePercent` = taux marginal. Une année sans
/// ligne = barème non renseigné (le dashboard demande de le saisir dans Réglages).
model IncomeTaxBracket {
  year        Int @db.SmallInt
  fromCents   Int
  ratePercent Int @db.SmallInt

  @@id([year, fromCents])
}

/// Statut juridique et fiscal de la société, choisi par année dans Réglages › Pro. Seul `SAS_IR` est
/// calculé pour l'instant (les autres sont affichés « Bientôt ») : un statut = un `ProRegime` côté serveur.
enum CompanyRegime {
  SAS_IR // SAS à l'impôt sur le revenu (option 5 exercices max)
  SAS_IS // SAS à l'impôt sur les sociétés
  EURL // EURL
}

/// Règles de Stygma pour une année (Réglages › Pro) : taux du bulletin de paie, charges sociales sur
/// la quote-part de bénéfice, clés des frais mixtes, barème km. Une année sans ligne reprend la
/// dernière année configurée avant elle (sinon `DEFAULT_PRO_YEAR_SETTINGS`, `shared/pro-rules.ts`).
/// Pas de float : taux en points de base (4460 = 44,60 %), surfaces en dm², barème en millièmes d'€.
model ProYearSettings {
  userId                 String
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  year                   Int           @db.SmallInt
  regime                 CompanyRegime @default(SAS_IR)
  /// Premier exercice avec l'option pour l'IR (5 exercices maximum).
  irOptionFirstYear      Int           @db.SmallInt
  grossSalaryCents       Int
  employerContributionBp Int
  employeeContributionBp Int
  /// Net imposable en % du brut (base du prélèvement à la source).
  taxableNetBp           Int
  withholdingTaxBp       Int
  /// Charges sociales sur la quote-part de bénéfice (réglées en perso).
  profitSocialChargesBp  Int
  officeAreaDm2          Int
  homeAreaDm2            Int
  /// Clé de répartition des autres frais mixtes (internet, téléphone, énergie) : numérateur / dénominateur.
  mixedKeyNumerator      Int           @db.SmallInt
  mixedKeyDenominator    Int           @db.SmallInt
  /// Barème kilométrique en millièmes d'euro par km (636 = 0,636 €/km).
  mileageRateMilli       Int

  @@id([userId, year])
}

/// Ligne de facturation prévue (prévisionnel) ou réellement facturée (saisie à la main : jours et TJM
/// ne figurent pas sur le relevé bancaire).
enum BillingKind {
  FORECAST // Prévu
  ACTUAL // Réel
}

/// Prestation d'un mois pour un client : jours × TJM, en prévisionnel ou en réel. Plusieurs clients
/// (donc plusieurs lignes) possibles dans un mois. CA HT = Σ demi-journées / 2 × TJM. Le client est
/// un simple nom saisi dans l'éditeur (autocomplétion sur les noms déjà utilisés), pas une table.
model BillingLine {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName     String
  year           Int         @db.SmallInt
  month          Int         @db.SmallInt
  kind           BillingKind
  dailyRateCents Int
  /// Demi-journées travaillées (3,5 jours = 7) : pas de float.
  halfDays       Int

  @@index([userId, year, month])
}

/// Montant prévu d'une catégorie pour un mois : charges pro, BNC prélevés, et dépenses perso des frais
/// mixtes (RENT, INTERNET…). Sans ligne, le prévisionnel prend sa valeur par défaut (réel N-1).
model MonthlyForecast {
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  year        Int                 @db.SmallInt
  month       Int                 @db.SmallInt
  category    TransactionCategory
  amountCents Int

  @@id([userId, year, month, category])
}

/// Kilomètres pro prévus pour un mois. Sans ligne : km réels du même mois l'année précédente.
model MileageForecast {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  year   Int    @db.SmallInt
  month  Int    @db.SmallInt
  km     Int

  @@id([userId, year, month])
}

/// Trajet pro (journal des frais kilométriques) : les km réels d'un mois = somme de ses trajets.
model Trip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  /// Dénormalisés depuis `date`, comme pour `Transaction`.
  month     Int      @db.SmallInt
  year      Int      @db.SmallInt
  route     String
  reason    String
  km        Int
  createdAt DateTime @default(now())

  @@index([userId, year, month])
}

enum ImportStatus {
  PENDING_REVIEW // En attente de relecture
  VALIDATED // Validé
}

/// Un fichier de relevé importé. Ses transactions sont écrites dès l'import (sans catégorie) ;
/// seuls les imports VALIDATED comptent dans les dashboards.
model ImportBatch {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountType  AccountType
  fileName     String
  status       ImportStatus  @default(PENDING_REVIEW)
  createdAt    DateTime      @default(now())
  validatedAt  DateTime?
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id                 String               @id @default(cuid())
  userId             String
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime             @db.Date
  label              String
  /// Montant en centimes, signé : négatif = débit, positif = crédit.
  amountCents        Int
  /// Dénormalisés depuis `date` pour les agrégations mois / année.
  month              Int                  @db.SmallInt
  year               Int                  @db.SmallInt
  accountType        AccountType
  category           TransactionCategory?
  /// Confiance (0 à 1) de la catégorie proposée par l'IA. `null` = catégorie absente ou choisie
  /// à la main. Sert à mettre en avant les lignes « À vérifier » à la relecture.
  categoryConfidence Float?
  importBatchId      String?
  importBatch        ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([userId, year, month])
  @@index([userId, accountType, year, month])
  @@index([category])
  @@index([importBatchId])
}

// ─── Authentification (Better Auth) ──────────────────────────────────────────────────────────
// Modèles imposés par Better Auth (adapter Prisma) : ne pas renommer les champs. Les données
// métier (`EnvelopeShare`, `ImportBatch`, `Transaction`) portent un `userId` : chaque requête
// tRPC filtre sur `ctx.session.user.id`. Aujourd'hui un seul `User`, créé par le seed
// (`prisma/seed.ts`, inscription publique désactivée). `IncomeTaxBracket` reste global (barème légal).

model User {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  envelopeShares   EnvelopeShare[]
  importBatches    ImportBatch[]
  transactions     Transaction[]
  proYearSettings  ProYearSettings[]
  billingLines     BillingLine[]
  monthlyForecasts MonthlyForecast[]
  mileageForecasts MileageForecast[]
  trips            Trip[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Identifiants d'un user : pour l'email + mot de passe, `providerId = "credential"` et `password` = hash.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
