// Prisma 7 : générateur "prisma-client" (client TS sans moteur Rust), sorti dans src/.
generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

// L'URL de connexion est dans prisma.config.ts (CLI) et src/server/db.ts (runtime).
datasource db {
  provider = "postgresql"
}

enum AccountType {
  PERSO
  PRO
}

/// Enveloppes budgétaires (méthode des « comptes » / enveloppes).
enum Envelope {
  DEPENSES_COURANTES
  LOISIRS
  FORMATION
  EPARGNE_SECURITE
  EPARGNE_LONG_TERME
  PRO
}

enum ImportStatus {
  PENDING_REVIEW
  VALIDATED
}

/// Un compte bancaire (ex. compte courant perso, compte pro Stygma).
model Account {
  id            String        @id @default(cuid())
  name          String        @unique
  type          AccountType
  bank          String?
  createdAt     DateTime      @default(now())
  importBatches ImportBatch[]
  transactions  Transaction[]
}

model Category {
  id           String        @id @default(cuid())
  /// Identifiant stable (seed idempotent, few-shot du prompt de catégorisation).
  slug         String        @unique
  name         String
  envelope     Envelope
  sortOrder    Int           @default(0)
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@index([envelope])
}

/// Un fichier de relevé importé. Les transactions ne sont écrites qu'à la validation.
model ImportBatch {
  id           String        @id @default(cuid())
  accountId    String
  account      Account       @relation(fields: [accountId], references: [id])
  fileName     String
  status       ImportStatus  @default(PENDING_REVIEW)
  createdAt    DateTime      @default(now())
  validatedAt  DateTime?
  transactions Transaction[]

  @@index([accountId])
}

model Transaction {
  id            String       @id @default(cuid())
  date          DateTime     @db.Date
  label         String
  /// Montant en centimes, signé : négatif = débit, positif = crédit.
  amountCents   Int
  /// Dénormalisés depuis `date` pour les agrégations mois / année.
  month         Int          @db.SmallInt
  year          Int          @db.SmallInt
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id])
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([year, month])
  @@index([accountId, year, month])
  @@index([categoryId])
  @@index([importBatchId])
}
