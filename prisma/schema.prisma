// Prisma 7 : générateur "prisma-client" (client TS sans moteur Rust), sorti dans src/.
generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

// L'URL de connexion est dans prisma.config.ts (CLI) et src/server/db.ts (runtime).
datasource db {
  provider = "postgresql"
}

/// Nature d'un relevé / d'une transaction : compte personnel ou compte pro (Stygma).
enum AccountType {
  PERSONAL // Perso
  PROFESSIONAL // Pro (Stygma)
}

/// Enveloppes budgétaires (méthode des « comptes » / enveloppes).
enum Envelope {
  CURRENT_EXPENSES // Dépenses courantes
  LEISURE // Loisirs
  TRAINING // Formation
  SAFETY_SAVINGS // Épargne sécurité
  LONG_TERM_SAVINGS // Épargne long terme
}

/// Catégorie d'une transaction (liste figée, colonnes du Google Sheet). Le libellé affiché et
/// l'enveloppe de rattachement vivent dans `src/lib/i18n/fr/enums.ts` et `src/lib/budget-rules.ts`.
enum TransactionCategory {
  RENT // Loyer
  FUEL // Essence
  BANK_INSURANCE // Banque et assurance
  RESTAURANT // Restaurant
  GROCERIES // Alimentaire
  NIGHTLIFE // Soirée
  LEISURE // Loisirs
  CLOTHING_CARE // Vêtements & Soins
  HEALTH // Santé
  TRANSPORT // Transport
  TAXES // Impôts et taxes
  OTHER_SUBSCRIPTIONS // Abonnements divers
  OTHER // Autres
  LONG_TERM_SAVINGS // Épargne long terme
  SALARY_PAYMENT // Versement salaire (revenu)
  BNC_PAYMENT // Versement BNC (revenu)
  VACATION_PAYMENT // Versement vacation (revenu)
  REFUND // Autre remboursement (crédit)
  PROFESSIONAL_REFUND // Remboursement pro : frais mixtes perso/pro remboursés par Stygma (crédit)
  TRAINING // Formation
  SHORT_TERM_SAVINGS // Épargne court terme
}

/// Part du revenu mensuel recommandée pour une enveloppe (en %). Une ligne par enveloppe
/// configurée ; sans ligne, la valeur par défaut de `DEFAULT_ENVELOPE_PERCENTS` (`src/lib/budget-rules.ts`) s'applique.
model EnvelopeShare {
  envelope Envelope @id
  percent  Int
}

enum ImportStatus {
  PENDING_REVIEW // En attente de relecture
  VALIDATED // Validé
}

/// Un fichier de relevé importé. Ses transactions sont écrites dès l'import (sans catégorie) ;
/// seuls les imports VALIDATED comptent dans les dashboards.
model ImportBatch {
  id            String        @id @default(cuid())
  accountType   AccountType
  fileName      String
  status        ImportStatus  @default(PENDING_REVIEW)
  createdAt     DateTime      @default(now())
  validatedAt   DateTime?
  transactions  Transaction[]
}

model Transaction {
  id                 String               @id @default(cuid())
  date               DateTime             @db.Date
  label              String
  /// Montant en centimes, signé : négatif = débit, positif = crédit.
  amountCents        Int
  /// Dénormalisés depuis `date` pour les agrégations mois / année.
  month              Int                  @db.SmallInt
  year               Int                  @db.SmallInt
  accountType        AccountType
  category           TransactionCategory?
  /// Confiance (0 à 1) de la catégorie proposée par l'IA. `null` = catégorie absente ou choisie
  /// à la main. Sert à mettre en avant les lignes « À vérifier » à la relecture.
  categoryConfidence Float?
  importBatchId      String?
  importBatch        ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([year, month])
  @@index([accountType, year, month])
  @@index([category])
  @@index([importBatchId])
}

// ─── Authentification (Better Auth) ──────────────────────────────────────────────────────────
// Modèles imposés par Better Auth (adapter Prisma) : ne pas renommer les champs. App
// mono-utilisateur : un seul `User`, créé par le seed (`prisma/seed.ts`, inscription publique
// désactivée), donc les données métier ne portent pas de `userId`.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Identifiants d'un user : pour l'email + mot de passe, `providerId = "credential"` et `password` = hash.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
