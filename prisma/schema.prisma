// Prisma 7 : générateur "prisma-client" (client TS sans moteur Rust), sorti dans src/.
generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

// L'URL de connexion est dans prisma.config.ts (CLI) et src/server/db.ts (runtime).
datasource db {
  provider = "postgresql"
}

enum BankAccountType {
  PERSO
  PRO
}

/// Enveloppes budgétaires (méthode des « comptes » / enveloppes).
enum Envelope {
  DEPENSES_COURANTES
  LOISIRS
  FORMATION
  EPARGNE_SECURITE
  EPARGNE_LONG_TERME
  PRO
}

/// Catégorie d'une transaction (liste figée, colonnes du Google Sheet). Le libellé affiché et
/// l'enveloppe de rattachement vivent dans `src/lib/categories.ts`.
enum TransactionCategory {
  ESSENCE
  ASSURANCE
  RESTAURANT
  ALIMENTAIRE
  SOIREE
  LOISIRS
  VETEMENTS_SOINS
  SANTE
  TRANSPORT
  IMPOTS_TAXES
  AUTRES_ABONNEMENTS
  AUTRES
  EPARGNE_LONG_TERME
}

enum ImportStatus {
  PENDING_REVIEW
  VALIDATED
}

/// Un compte bancaire (ex. compte courant perso, compte pro Stygma).
model BankAccount {
  id            String          @id @default(cuid())
  name          String          @unique
  type          BankAccountType
  bank          String?
  createdAt     DateTime        @default(now())
  importBatches ImportBatch[]
  transactions  Transaction[]
}

/// Un fichier de relevé importé. Ses transactions sont écrites dès l'import (sans catégorie) ;
/// seuls les imports VALIDATED comptent dans les dashboards.
model ImportBatch {
  id            String        @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount   @relation(fields: [bankAccountId], references: [id])
  fileName      String
  status        ImportStatus  @default(PENDING_REVIEW)
  createdAt     DateTime      @default(now())
  validatedAt   DateTime?
  transactions  Transaction[]

  @@index([bankAccountId])
}

model Transaction {
  id            String               @id @default(cuid())
  date          DateTime             @db.Date
  label         String
  /// Montant en centimes, signé : négatif = débit, positif = crédit.
  amountCents   Int
  /// Dénormalisés depuis `date` pour les agrégations mois / année.
  month         Int                  @db.SmallInt
  year          Int                  @db.SmallInt
  bankAccountId String
  bankAccount   BankAccount          @relation(fields: [bankAccountId], references: [id])
  category      TransactionCategory?
  importBatchId String?
  importBatch   ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([year, month])
  @@index([bankAccountId, year, month])
  @@index([category])
  @@index([importBatchId])
}
