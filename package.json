{
  "name": "budget-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "ts:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --ui",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rules:check": "tsx scripts/check-yearly-rules.ts",
    "check": "pnpm lint && pnpm ts:check && pnpm format:check && pnpm knip && pnpm test",
    "postinstall": "pnpm db:generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:seed": "prisma db seed",
    "vercel-build": "prisma migrate deploy && vite build"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@google/genai": "^2.25.0",
    "@mantine/core": "9.6.3",
    "@mantine/dropzone": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.0",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "better-auth": "^1.7.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0",
    "superjson": "^2.2.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vfourny/node-toolkit": "2.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "commitlint": "20.5.3",
    "dotenv": "^18.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jiti": "^2.7.0",
    "knip": "^6.39.0",
    "lefthook": "^2.1.14",
    "nitro": "3.0.260903-beta",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "4.1.12"
  }
}
