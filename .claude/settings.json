{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm format:*)",
      "Bash(pnpm format)",
      "Bash(pnpm check)",
      "Bash(pnpm build)",
      "Bash(pnpm exec prisma validate:*)",
      "Bash(pnpm exec prisma format:*)",
      "Bash(pnpm exec prisma generate:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
