# Neon — connexion POOLED (host "-pooler"), utilisée par l'app au runtime (Vercel serverless)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/budget?sslmode=require"
# Neon — connexion DIRECTE (sans "-pooler"), utilisée par la CLI Prisma (migrate)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/budget?sslmode=require"

# API Gemini (Google AI Studio, palier gratuit) — catégorisation des lignes de relevé
GEMINI_API_KEY="AIza..."
# Optionnel : modèle Gemini à utiliser (défaut : gemini-3.5-flash-lite)
# GEMINI_MODEL="gemini-3.5-flash-lite"
